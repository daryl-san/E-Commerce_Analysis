filepath = r"C:\Users\deeye\OneDrive\Desktop\Data Analytics Personal Project\E-Commerce_Analysis\Dataset\ecommerce_sales_analytics_5000.csv"

# load dataset into dataframe
ecom_df = pd.read_csv(filepath, parse_dates = ["order_date"]) 
# ecom_df = pd.read_csv(filepath, parse_dates = ["order_date"], date_format="%d/%m/%Y") # This incase we want d/m/YYYY for date format

# Check if any nulls
