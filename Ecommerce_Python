# print(ecom_df['region'].unique())             #['South' 'East' 'West' 'North']

# convert columns into type 'category'
cols_to_convert = ['product_category','payment_method','region']
ecom_df[cols_to_convert] = ecom_df[cols_to_convert].astype('category')

# create new columns to store year, month, and day of sale
ecom_df['year'] = ecom_df['order_date'].dt.year
ecom_df['month'] = ecom_df['order_date'].dt.month
ecom_df['day'] = ecom_df['order_date'].dt.day
ecom_df['month_name'] = ecom_df['order_date'].dt.month_name()
ecom_df['day_name'] = ecom_df['order_date'].dt.day_name()
ecom_df['year_month'] = ecom_df['order_date'].dt.to_period("M")

# ( unit_price * (1-discount) ) * quantity = revenue
# get pre-discount revenue
ecom_df['pre_discount_revenue'] = ecom_df['unit_price'] * ecom_df['quantity']

ecom_df['revenue_discounted_from_purchase'] = ecom_df['pre_discount_revenue'] - ecom_df['revenue']



